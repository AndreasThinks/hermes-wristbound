<resources>
    <!--
      No window action bar: the setup screen draws its own toolbar above the scrolling form and
      pads both for the system bars, so nothing scrolls under the title or the status bar.
      Always dark: Phosphor is black glass whatever the system theme.
    -->
    <style name="Theme.Wristbound" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/phosphor_glass</item>
        <item name="colorPrimaryDark">@color/phosphor_glass</item>
        <item name="colorAccent">@color/phosphor_signal</item>
        <item name="colorControlActivated">@color/phosphor_signal</item>
        <item name="android:windowBackground">@color/phosphor_glass</item>
        <item name="android:textColorPrimary">@color/phosphor_text</item>
        <item name="android:textColorSecondary">@color/phosphor_note</item>
        <item name="android:textColorHint">@color/phosphor_meta</item>
    </style>

    <style name="TextAppearance.Wristbound.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/phosphor_text</item>
    </style>
</resources>
